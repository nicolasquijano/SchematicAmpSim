{
  "id": "highgain_120",
  "order": 4,
  "output_db": 10.1,
  "name": "American 5050",

  "theme": {
    "background": "#08090a",
    "panel": "#131416",
    "edge": "#2f3336",
    "accent": "#6fd36b",
    "label": "#84928a",
    "text": "#e1e8e2",
    "knob_top": "#34393b",
    "knob_bottom": "#0f1112",
    "pointer": "#e7ffe6"
  },

  "preamp": {
    "netlist": "preamp.net",
    "stages": [
      { "netlist": "stage2.net", "link_from": "p1b", "link_source": "VLNK" },
      { "netlist": "stage3.net", "link_from": "o5a", "link_source": "VLNK" }
    ],
    "tolerance": 2e-6,
    "rail_source": "VRAIL",
    "input_source": "VIN",
    "output_node": "pl",
    "pot_min_ohms": 100,
    "jack_label": "CHANNEL",
    "knobs": [
      { "name": "lead_pre",     "default": 0.5, "pot": { "type": "wiper", "top": "VR2_T", "bottom": "VR2_B", "total": 1e6, "taper": "log" } },
      { "name": "rhythm_pre",   "default": 0.5, "pot": { "type": "wiper", "top": "VR1_T", "bottom": "VR1_B", "total": 1e6, "taper": "log" } },
      { "name": "lead_post",    "default": 0.5, "pot": { "type": "wiper", "top": "VR7_T", "bottom": "VR7_B", "total": 1e6, "taper": "log" } },
      { "name": "rhythm_post",  "default": 0.5, "pot": { "type": "wiper", "top": "VR6_T", "bottom": "VR6_B", "total": 1e6, "taper": "log" } },
      { "name": "low",    "default": 0.5, "pot": { "type": "variable", "resistor": "VR3", "total": 1e6, "taper": "log" } },
      { "name": "mid",    "default": 0.5, "pot": { "type": "wiper", "top": "VR4_T", "bottom": "VR4_B", "total": 50e3, "taper": "linear" } },
      { "name": "high",   "default": 0.5, "pot": { "type": "wiper", "top": "VR5_T", "bottom": "VR5_B", "total": 250e3, "taper": "linear" } }
    ],
    "source_ohms": { "resistors": ["RSRC"], "default": 7000, "min": 10 },
    "jacks": [
      { "name": "rhythm", "label": "Rhythm", "level_db": 17.0, "drive": "VIN", "resistors": {
          "SW_K2A3": 1, "SW_K2A4": 1e12, "SW_K2B6": 1, "SW_K2B5": 1e12, "SW_K4A3": 1,    "SW_K4A4": 1e12, "SW_K4B6": 1,    "SW_K1A": 1,    "SW_K1B": 1 } },
      { "name": "crunch", "label": "Crunch", "level_db": 3.2, "drive": "VIN", "resistors": {
          "SW_K2A3": 1, "SW_K2A4": 1e12, "SW_K2B6": 1, "SW_K2B5": 1e12, "SW_K4A3": 1e12, "SW_K4A4": 1,    "SW_K4B6": 1e12, "SW_K1A": 1,    "SW_K1B": 1 } },
      { "name": "lead",   "label": "Lead",   "drive": "VIN", "resistors": {
          "SW_K2A3": 1e12, "SW_K2A4": 1, "SW_K2B6": 1e12, "SW_K2B5": 1, "SW_K4A3": 1,    "SW_K4A4": 1e12, "SW_K4B6": 1,    "SW_K1A": 1e12, "SW_K1B": 1e12 } }
    ]
  },

  "ui": [
    { "param": "volume",   "knob": "lead_pre",    "label": "LEAD PRE" },
    { "param": "volume2",  "knob": "rhythm_pre",  "label": "RHYTHM PRE" },
    { "param": "master",   "knob": "lead_post",   "label": "LEAD POST" },
    { "param": "power",    "knob": "rhythm_post", "label": "RHYTHM POST" },
    { "param": "bass",     "knob": "low",         "label": "LOW" },
    { "param": "middle",   "knob": "mid",         "label": "MID" },
    { "param": "treble",   "knob": "high",        "label": "HIGH" },
    { "param": "presence",                         "label": "PRESENCE" },
    { "param": "resonance", "power_knob": "resonance", "label": "RESONANCE" }
  ],

  "power": {
    "tubes": [
      { "name": "6L6GC", "model": "6L6GCDS", "pmax_w": 30.0, "bias_scale": 1.0 },
      { "name": "EL34", "model": "EL34", "pmax_w": 25.0, "bias_scale": 0.8681 },
      { "name": "6550", "model": "6550DS", "pmax_w": 35.0, "bias_scale": 1.2011 }
    ],
    "bias": { "source": "VBIAS", "idle_resistors": ["DCR_PT", "DCR_PB"], "tubes_per_half": 2 },
    "netlist": "poweramp.net",
    "tolerance": 1e-4,
    "input_source": "VAUDIO",
    "ht_source": "VHT",
    "ht_node": "a",
    "rail_node": "x",
    "output_node": "t8",
    "load_resistor": "RLOAD",
    
    "presence": { "resistor": "VR9_B", "complement": "VR9_T", "scale": 10e3, "min_ohms": 50, "default": 0.5 },
    "knobs": [
      { "name": "resonance", "resistor": "VR8", "scale": 1e6, "min_ohms": 100, "default": 0.5 }
    ],
    "supply": {
      "mains_hz": 60,
      "vac_peak": 540,
      "rect_source_ohms": 60,
      "ht_dc_source": 490,
      "rect_drop": 1.4,
      "reservoir_farads": 215e-6,
      "tie_ohms": 1.0,
      "settle_seconds": 0.15
    }
  },

  "lite": {
  "base_gain_db": 17.4105,
  "high_pass_hz": 22.0008,
  "shelf_hz": 1093.14,
  "presence_db": [0, 0.282758, 0.782716, 1.97159, 6.02256],
  "sag_table": [[0, 0], [2.54648, 1.00895], [5.09296, 3.95162], [9.5493, 13.0269], [15.9155, 31.7948], [22.2817, 53.2223], [28.6479, 69.8419], [35.0141, 78.6778], [44.5634, 85.8706], [57.2958, 91.5786], [82.7606, 99.4071], [127.324, 102.798]],
  "rail_x_idle": 440.598,
  "rail_sag_fraction": 0.58,
  "ceiling_light": 56.1957,
  "ceiling_heavy": 36.3246,
  "ceiling_decay": 16.6186,
  "knee": 7.95488,
