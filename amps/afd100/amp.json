{
  "id": "afd100",
  "order": 2,
  "output_db": 3.9,
  "name": "SLSH 100W",

  "ui": [
    { "param": "volume",   "knob": "volume",      "label": "PREAMP" },
    { "param": "bass",     "knob": "bass",        "label": "BASS" },
    { "param": "middle",   "knob": "middle",      "label": "MIDDLE" },
    { "param": "treble",   "knob": "treble",      "label": "TREBLE" },
    { "param": "presence",                          "label": "PRESENCE" },
    { "param": "master",   "knob": "master",      "label": "MASTER" },
    { "param": "power",    "power_knob": "power",  "label": "POWER" }
  ],

  "eco_preamp": {
    "netlist": "eco1.net",
    "stages": [
      { "netlist": "eco2.net",   "link_from": "p5", "link_source": "VLINK" },
      { "netlist": "master.net", "link_from": "so", "link_source": "VLINK" }
    ]
  },

  "preamp": {
    "netlist": "preamp.net",
    "stages": [ { "netlist": "master.net", "link_from": "so", "link_source": "VLINK" } ],
    "tolerance": 2e-6,
    "rail_source": "VRAIL",
    "input_source": "VIN",
    "output_node": "mo",
    "pot_min_ohms": 100,
    "jack_label": "MODE",
    "knobs": [
      { "name": "volume", "default": 0.6, "pot": { "type": "wiper", "top": "VR1_T", "bottom": "VR1_B", "total": 1e6,   "taper": "log" } },
      { "name": "bass",   "default": 0.5, "pot": { "type": "wiper", "top": "VR5_T", "bottom": "VR5_B", "total": 1e6,   "taper": "log" } },
      { "name": "middle", "default": 0.5, "pot": { "type": "wiper", "top": "VR4_T", "bottom": "VR4_B", "total": 25e3,  "taper": "linear" } },
      { "name": "treble", "default": 0.6, "pot": { "type": "wiper", "top": "VR3_T", "bottom": "VR3_B", "total": 250e3, "taper": "linear" } },
      { "name": "master", "default": 0.5, "pot": { "type": "wiper", "top": "VR2_T", "bottom": "VR2_B", "total": 1e6,   "taper": "log" } }
    ],
    "source_ohms": { "resistors": ["RSRC"], "default": 7000, "min": 10 },
    "jacks": [
      { "name": "normal", "label": "Normal", "drive": "VIN", "resistors": { "SW_RL3B": 1e12, "SW_RL1B_N": 1,    "SW_RL1B_A": 1e12, "SW_RL1C": 1e12 } },
      { "name": "afd",    "label": "Alt",    "level_db": 1.0, "drive": "VIN", "resistors": { "SW_RL3B": 1,    "SW_RL1B_N": 1e12, "SW_RL1B_A": 1,    "SW_RL1C": 1 } }
    ]
  },

  "power": {
    "tubes": [
      { "name": "6550", "model": "6550DS", "pmax_w": 35.0, "bias_scale": 1.0 },
      { "name": "EL34", "model": "EL34", "pmax_w": 25.0, "bias_scale": 0.7089 },
      { "name": "6L6GC", "model": "6L6GCDS", "pmax_w": 30.0, "bias_scale": 0.7441 }
    ],
    "bias": { "source": "VBIAS", "idle_resistors": ["DCR_PT", "DCR_PB"], "tubes_per_half": 2 },
    "netlist": "poweramp.net",
    "tolerance": 1e-4,
    "input_source": "VAUDIO",
    "ht_source": "VHT",
    "ht_node": "a",
    "rail_node": "x",
    "output_node": "t16",
    "load_resistor": "RLOAD",
    "nfb_resistor": "R99",
    "presence": { "resistor": "VR6A", "scale": 25e3, "min_ohms": 50, "default": 0.5 },
    "knobs": [
      { "name": "power", "resistor": "NFB_VAR", "scale": 100e3, "min_ohms": 50, "default": 0.5 }
    ],
    "supply": {
      "mains_hz": 50,
      "vac_peak": 540,
      "rect_source_ohms": 50,
      "ht_dc_source": 520,
      "rect_drop": 1.4,
      "reservoir_farads": 100e-6,
      "tie_ohms": 1.0,
      "settle_seconds": 0.15
    }
  },

  "lite": {
  "base_gain_db": 22.9256,
  "high_pass_hz": 14.5305,
  "shelf_hz": 246.455,
  "presence_db": [0, 0.155345, 0.432062, 1.06368, 3.88675],
  "sag_table": [[0, 0], [2.54648, 0.777002], [5.09296, 3.04381], [9.5493, 10.0116], [15.9155, 24.1747], [22.2817, 40.2204], [28.6479, 52.5762], [35.0141, 56.0136], [44.5634, 58.9435], [57.2958, 63.0307], [82.7606, 68.443], [127.324, 72.8093]],
  "rail_x_idle": 452.109,
  "rail_sag_fraction": 0.58,
  "ceiling_light": 81.1954,
  "ceiling_heavy": 40.3543,
  "ceiling_decay": 6.99858,
  "knee": 24.5413,
  "sag_attack_s": 0.01,
  "sag_release_s": 0.06
}
}
