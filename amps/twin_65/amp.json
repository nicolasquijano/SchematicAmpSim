{
  "id": "twin_65",
  "order": 3,
  "output_db": 8.4,
  "name": "American Twin",

  "preamp": {
    "netlist": "preamp.net",
    "tolerance": 2e-6,
    "rail_source": "VRAIL",
    "input_source": "VIN",
    "output_node": "m1",
    "pot_min_ohms": 100,
    "jack_label": "INPUT",
    "knobs": [
      { "name": "vibrato_volume", "default": 0.5, "pot": { "type": "wiper", "top": "VR_VT_V", "bottom": "VR_VB_V", "total": 1e6, "taper": "log30" } },
      { "name": "normal_volume",  "default": 0.5, "pot": { "type": "wiper", "top": "VR_VT_N", "bottom": "VR_VB_N", "total": 1e6, "taper": "log30" } },
      { "name": "bass",   "default": 0.6, "pot": { "type": "variable", "resistor": "VR_BASS_V", "total": 250e3, "taper": "log10",
                                                 "also": [ { "resistor": "VR_BASS_N" } ] } },
      { "name": "middle", "default": 0.5, "pot": { "type": "variable", "resistor": "VR_MID_V",  "total": 10e3,  "taper": "log10",
                                                 "also": [ { "resistor": "VR_MID_N" } ] } },
      { "name": "treble", "default": 0.6, "pot": { "type": "wiper", "top": "VR_TT_V", "bottom": "VR_TB_V", "total": 250e3, "taper": "log30",
                                                 "also": [ { "top": "VR_TT_N", "bottom": "VR_TB_N" } ] } },
      { "name": "intensity", "default": 0.5, "pot": { "type": "wiper", "top": "VR_INT_T", "bottom": "VR_INT_B", "total": 50e3, "taper": "revlog" } },
      { "name": "reverb", "default": 0.3, "pot": { "type": "wiper", "top": "VR_REV_T", "bottom": "VR_REV_B", "total": 100e3, "taper": "linear" } }
    ],
    "reverb": {
      "netlist": "reverb.net",
      "rail_source": "VRAIL",
      "grid_source": "VG3",
      "grid_node": "gv3",
      "out_node": "pv4",
      "main_source": "VREVOUT",
      "tank_in_node": "ts",
      "tank_out_source": "VREV",
      "gain": 0.00147,
      "springs": [
        { "delay_ms": 33, "sections": 80, "coefficient": -0.5, "loop_gain": 0.92, "loss_hz": 3500 },
        { "delay_ms": 41, "sections": 80, "coefficient": -0.5, "loop_gain": 0.92, "loss_hz": 3500 }
      ]
    },
    "vibrato": {
      "netlist": "vibrato.net",
      "rail_source": "VRAIL",
      "led": { "from": "x", "to": "ln", "ohms": 100e3 },
      "switch": { "resistor": "SW_VIB", "on_ohms": 10e3, "off_ohms": 1e12 },
      "speed": { "resistor": "R_SPEED", "total": 3e6, "taper": "log10", "invert": true, "default": 0.5 },
      "cell": { "resistor": "R_CELL", "dark_ohms": 2e6, "ohms_at_1ma": 4e3, "exponent": 0.8, "attack_s": 0.004, "release_s": 0.03 },
      "control_samples": 64
    },
    "source_ohms": { "resistors": ["RSRC"], "default": 7000, "min": 10 },
    "jacks": [
      { "name": "vibrato1", "label": "Vibrato 1", "drive": "VIN", "resistors": {
          "SW_V1": 1, "SW_V2": 1e12, "SW_VTN": 1,    "SW_VNG": 1e12, "SW_N1": 1e12, "SW_N2": 1e12, "SW_NTN": 1, "SW_NNG": 1 } },
      { "name": "vibrato2", "label": "Vibrato 2", "level_db": 6.4, "drive": "VIN", "resistors": {
          "SW_V1": 1e12, "SW_V2": 1, "SW_VTN": 1e12, "SW_VNG": 1,    "SW_N1": 1e12, "SW_N2": 1e12, "SW_NTN": 1, "SW_NNG": 1 } },
      { "name": "normal1",  "label": "Normal 1",  "level_db": 2.3, "drive": "VIN", "resistors": {
          "SW_N1": 1, "SW_N2": 1e12, "SW_NTN": 1,    "SW_NNG": 1e12, "SW_V1": 1e12, "SW_V2": 1e12, "SW_VTN": 1, "SW_VNG": 1 } },
      { "name": "normal2",  "label": "Normal 2",  "level_db": 8.6, "drive": "VIN", "resistors": {
          "SW_N1": 1e12, "SW_N2": 1, "SW_NTN": 1e12, "SW_NNG": 1,    "SW_V1": 1e12, "SW_V2": 1e12, "SW_VTN": 1, "SW_VNG": 1 } }
    ]
  },

  "ui": [
    { "param": "volume",  "knob": "vibrato_volume", "label": "VIB CHANNEL" },
    { "param": "volume2", "knob": "normal_volume",  "label": "NORM CHANNEL" },
    { "param": "bass",    "knob": "bass",           "label": "BASS" },
    { "param": "middle",  "knob": "middle",         "label": "MIDDLE" },
    { "param": "treble",  "knob": "treble",         "label": "TREBLE" },
    { "param": "vib_speed",     "label": "SPEED" },
    { "param": "vib_intensity", "knob": "intensity", "label": "INTENSITY" },
    { "param": "reverb",        "knob": "reverb",    "label": "REVERB" }
  ],

  "power": {
    "netlist": "poweramp.net",
    "tolerance": 1e-4,
    "input_source": "VAUDIO",
    "ht_source": "VHT",
    "ht_node": "a",
    "rail_node": "x",
    "output_node": "t4",
    "load_resistor": "RLOAD",
    "supply": {
      "mains_hz": 60,
      "vac_peak": 478,
      "rect_source_ohms": 35,
      "ht_dc_source": 442,
      "rect_drop": 1.4,
      "reservoir_farads": 110e-6,
      "tie_ohms": 15,
      "settle_seconds": 0.15
    }
  },

  "lite": {
  "base_gain_db": 13.7075,
  "high_pass_hz": 30.4348,
  "shelf_hz": 150,
  "presence_db": [0, 0, 0, 0, 0],
  "sag_table": [[0, 0], [2.54648, 1.92881], [5.09296, 7.42583], [9.5493, 22.8534], [15.9155, 48.6213], [22.2817, 55.1589], [28.6479, 57.6162], [35.0141, 59.8413], [44.5634, 63.0658], [57.2958, 66.2821], [82.7606, 70.0642], [127.324, 73.2465]],
  "rail_x_idle": 392.453,
  "rail_sag_fraction": 0.58,
  "ceiling_light": 23.1388,
  "ceiling_heavy": 22.2779,
  "ceiling_decay": 8.10015,
  "knee": 34.1248,
  "sag_attack_s": 0.01,
  "sag_release_s": 0.06
}
}
